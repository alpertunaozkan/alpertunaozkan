# Ortam değişkenleri. Bu dosyayı `.env.local` adıyla kopyalayıp değerleri
# doldurun (`.env.local` git'e eklenmez). Canlı ortamda aynı değişkenler
# barındırma ortamının ayarlarına girilir. Bu dosyaya gerçek değer yazmayın.

# Sitenin herkese açık adresi (canonical, sitemap ve Open Graph URL'leri).
# Tanımlanmazsa https://www.alpertunaozkan.com kullanılır. Gizli değer değildir.
NEXT_PUBLIC_SITE_URL=https://www.alpertunaozkan.com

# --- MongoDB Atlas -----------------------------------------------------------
# Atlas → Database → Connect → Drivers ekranındaki adres (mongodb+srv://...).
# Kullanıcı adı/şifredeki özel karakterler URL kodlanmalıdır (@ → %40, $ → %24).
MONGODB_URI=
# İsteğe bağlı: adreste veritabanı adı yoksa kullanılacak veritabanı.
# Boşsa adresteki ad, o da yoksa "test" kullanılır (eski API ile aynı davranış).
MONGODB_DB=

# --- Yönetici girişi (tek kullanıcı: Av. Alper Tuna Özkan) ---------------------
ADMIN_USERNAME=
# Şifrenin kendisi değil, özeti yazılır: `pnpm admin:hash-password` şifreyi sorar
# ve bu satırı .env.local içinde kendisi doldurur.
ADMIN_PASSWORD_HASH=

# --- Cloudinary (makale görselleri) ------------------------------------------
# Cloudinary → Settings → API Keys. API secret yalnızca sunucuda kullanılır.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Görsellerin yüklendiği klasör (eski projeyle aynı).
CLOUDINARY_ARTICLE_FOLDER=articles
# İsteğe bağlı: imzalı yükleme ön ayarı (Settings → Upload → Upload presets).
CLOUDINARY_ARTICLE_UPLOAD_PRESET=

# --- İsteğe bağlı: site birden fazla sunucuda/örnekte çalışacaksa -------------
# Hepsinde aynı olmalıdır (Server Action kimliklerinin şifrelenmesi).
# Üretmek için: openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- Yalnızca eski verileri aktarma betiği (pnpm db:migrate-legacy) ------------
# Eski veriler farklı bir kümede veya veritabanındaysa doldurun.
# Boşsa MONGODB_URI adresindeki veritabanı okunur (eski API ile aynı).
# LEGACY_MONGODB_URI=
# LEGACY_MONGODB_DB=
